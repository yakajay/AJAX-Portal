PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (required) ---
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
# URL-encode special characters in the password (e.g. @ becomes %40).
# Firestore (MongoDB compatibility): mongodb://<user>:<password>@<db-uid>.<region>.firestore.goog:443/<db>?loadBalanced=true&authMechanism=SCRAM-SHA-256&tls=true&retryWrites=false
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name to use (created automatically on first write)
MONGODB_DB_NAME=yakflow

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# (see Sessions below)
OTP_TTL_MINUTES=10

# SMTP for OTP emails. If SMTP_HOST is empty (development only), codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YakFlow <no-reply@example.com>"

# --- Sessions / security ---
# Access tokens are short-lived; a refresh token (revocable per device) renews them.
# JWT_EXPIRES_IN=15m
# REFRESH_TTL_HOURS=12
# Set when running behind a reverse proxy so req.ip is the client address (e.g. 1 or "loopback")
# TRUST_PROXY=
# Require "Authorization: Bearer <token>" on GET /api/metrics when set
# METRICS_TOKEN=
# LOG_LEVEL=info

# --- Attendance policy (all optional) ---
# ATTENDANCE_LATE_AFTER=09:30
# ATTENDANCE_EARLY_BEFORE=17:30
# ATTENDANCE_STANDARD_HOURS=8
# Comma separated IPs or prefixes (e.g. 203.0.113.  ) allowed to clock in; empty = anywhere
# ATTENDANCE_ALLOWED_IPS=
# Geofence: clock-in must be within OFFICE_RADIUS_M metres of this point
# OFFICE_LAT=
# OFFICE_LNG=
# OFFICE_RADIUS_M=300

# --- Background jobs ---
# JOBS_ENABLED=true
# DIGEST_HOUR=8
# CONTRACT_ALERT_DAYS=30

# --- Multi-tenancy ---
# Companies live at <slug>.BASE_DOMAIN (e.g. acme.ourhrms.com); the Super Admin console at admin.BASE_DOMAIN.
# Local development: BASE_DOMAIN=localhost, then browse http://acme.localhost:5173 (browsers resolve *.localhost).
# BASE_DOMAIN=localhost
# PLATFORM_SUBDOMAIN=admin
# Used to show company admins the exact redirect / ACS URLs to register with their identity provider
# PUBLIC_SCHEME=https
# PUBLIC_PORT=
# Single-company install without wildcard DNS: any other host serves this company
# DEFAULT_TENANT_SLUG=

# --- Encryption of sensitive employee data (salary, bank details, government IDs) ---
# 32-byte master key (64 hex chars or base64) that wraps each company's own data key. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=

# --- Single sign-on ---
# Each company configures its own OpenID Connect / SAML 2.0 provider in Company settings.
# Allow identity providers hosted on private network addresses (off by default; guards against SSRF)
# SSO_ALLOW_PRIVATE_HOSTS=false
