PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (required) ---
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
# URL-encode special characters in the password (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://ajaykumaryakkali_db_user:<db_password>@cluster0.h27rsad.mongodb.net/?appName=Cluster0
# Database name to use (created automatically on first write)
MONGODB_DB_NAME=yakflow

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
OTP_TTL_MINUTES=10

# SMTP for OTP emails. If SMTP_HOST is empty (development only), codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YakFlow <no-reply@example.com>"
