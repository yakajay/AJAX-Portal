PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (required) ---
# Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
# URL-encode special characters in the password (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://ajaykumaryakkali_db_user:<db_password>@cluster0.h27rsad.mongodb.net/?appName=Cluster0
# Database name to use (created automatically on first write)
MONGODB_DB_NAME=yakflow

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# (see Sessions below)
OTP_TTL_MINUTES=10

# SMTP for OTP emails. If SMTP_HOST is empty (development only), codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YakFlow <no-reply@example.com>"

# --- Sessions / security ---
# Access tokens are short-lived; a refresh token (revocable per device) renews them.
# JWT_EXPIRES_IN=15m
# REFRESH_TTL_HOURS=12
# Set when running behind a reverse proxy so req.ip is the client address (e.g. 1 or "loopback")
# TRUST_PROXY=
# Require "Authorization: Bearer <token>" on GET /api/metrics when set
# METRICS_TOKEN=
# LOG_LEVEL=info

# --- Attendance policy (all optional) ---
# ATTENDANCE_LATE_AFTER=09:30
# ATTENDANCE_EARLY_BEFORE=17:30
# Comma separated IPs or prefixes (e.g. 203.0.113.  ) allowed to clock in; empty = anywhere
# ATTENDANCE_ALLOWED_IPS=
# Geofence: clock-in must be within OFFICE_RADIUS_M metres of this point
# OFFICE_LAT=
# OFFICE_LNG=
# OFFICE_RADIUS_M=300

# --- Background jobs ---
# JOBS_ENABLED=true
# DIGEST_HOUR=8
# CONTRACT_ALERT_DAYS=30

# --- Single sign-on (OpenID Connect) - leave SSO_ISSUER empty to disable ---
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0   Google: https://accounts.google.com
# SSO_ISSUER=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# Redirect URI to register with the provider (this server's callback)
# SSO_REDIRECT_URI=http://localhost:5000/api/auth/sso/callback
# SSO_PROVIDER_NAME=Microsoft
# Comma separated company email domains allowed to sign in (REQUIRED when SSO is on)
# SSO_ALLOWED_DOMAINS=yaksofts.com
# Create a USER account on first SSO login (set false to only allow existing users)
# SSO_AUTO_PROVISION=true
